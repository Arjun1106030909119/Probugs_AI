{
  "manifest_version": 3,
  "name": "ProBugs",
  "version": "1.2.0",
  "description": "Report bugs directly to your ProBugs dashboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://probugs-ai.onrender.com/*",
    "https://probugs-ai.vercel.app/*",
    "https://probugs-backend.onrender.com/*"
  ]
}
